// Wovie v2 — Database Schema
// Prisma ORM + PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================
// Users & Auth
// ========================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites  Favorite[]
  watchHistory WatchHistory[]
  reviews    Review[]
  watchlists Watchlist[]
}

// ========================
// Movies (from TMDB)
// ========================

model Movie {
  id          Int      @id // TMDB movie ID
  title       String
  description String?  @db.Text
  posterUrl   String?
  backdropUrl String?
  trailerUrl  String?
  releaseDate DateTime?
  rating      Float    @default(0) // TMDB vote_average, 0–10
  voteCount   Int      @default(0) // TMDB vote_count
  popularity  Float    @default(0) // TMDB popularity
  /// Bayesian average of rating and voteCount against the whole catalogue,
  /// recomputed after every sync (app/lib/ratings.ts). Used for "Top rated".
  weightedRating Float @default(0)
  runtime     Int?
  createdAt   DateTime @default(now())
  syncedAt    DateTime @default(now())

  genres    MovieGenre[]
  cast      MovieActor[]
  favorites Favorite[]
  reviews   Review[]
  watchlistItems WatchlistItem[]
  watchHistory WatchHistory[]

  @@index([popularity])
  @@index([weightedRating])
  @@index([releaseDate])
}

model Genre {
  id     Int    @id // TMDB genre ID
  name   String @unique
  movies MovieGenre[]
}

model Actor {
  id           Int     @id // TMDB actor ID
  name         String
  profilePhoto String?
  movies       MovieActor[]
}

// ========================
// Junction Tables
// ========================

model MovieGenre {
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId Int
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)
  genreId Int

  @@id([movieId, genreId])
}

model MovieActor {
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId Int
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId Int
  role    String?

  @@id([movieId, actorId])
}

// ========================
// User Features
// ========================

model Favorite {
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId Int
  addedAt DateTime @default(now())

  @@id([userId, movieId])
}

// A user's own score for a film. The film page shows the average of these as
// the Wovie rating.
model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-10
  content   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  movie   Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId Int

  @@unique([userId, movieId]) // One review per user per movie
}

model Watchlist {
  id        String   @id @default(cuid())
  name      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  items  WatchlistItem[]
}

model WatchlistItem {
  addedAt DateTime @default(now())

  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  watchlistId String
  movie       Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId     Int

  @@id([watchlistId, movieId])
}

/// Unused: Wovie has no player, so nothing reads or writes this table any
/// more. It stays until the release that stops reading it is live, then a
/// follow-up migration drops it (dropping it now would break the profile page
/// of the version currently in production).
model WatchHistory {
  id             String   @id @default(cuid())
  watchedSeconds Int      @default(0)
  totalSeconds   Int
  updatedAt      DateTime @updatedAt

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId Int

  @@unique([userId, movieId])
}

// ========================
// Catalogue sync bookkeeping
// ========================

// One row ("catalog"). Lets every server instance agree on whether a sync is
// running or recent, so TMDB is not hit by every visitor.
model CatalogSync {
  id         String    @id
  startedAt  DateTime?
  finishedAt DateTime?
}
