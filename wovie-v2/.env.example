# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Neon in production). Needed by the app, migrations and the seed.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# TMDB v3 API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=""
# Optional: point at a stand-in for local development or tests.
# TMDB_API_BASE_URL="https://api.themoviedb.org/3"

# NextAuth: a long random string (e.g. `openssl rand -base64 32`), and the site's URL.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
